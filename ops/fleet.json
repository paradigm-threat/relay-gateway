{
  "schema": "relay.ops.fleet.v1",
  "fleetIngress": "fleet.relaygateway.net",
  "gitPort": 9418,
  "features": {
    "piperTts": true
  },
  "mail": {
    "host": "pub1.relaygateway.net",
    "maildir": "/home/arl/Maildir"
  },
  "nodes": [
    {
      "fqdn": "pub1.relaygateway.net",
      "sshUser": "root",
      "deployTarget": "linode-pub1",
      "role": "publisher",
      "fleetDns": true
    },
    {
      "fqdn": "mesh1.relaygateway.net",
      "sshUser": "root",
      "deployTarget": "linode-mesh1",
      "role": "mesh",
      "fleetDns": false
    },
    {
      "fqdn": "mesh2.relaygateway.net",
      "sshUser": "root",
      "deployTarget": "linode-mesh2",
      "role": "mesh",
      "fleetDns": false
    }
  ],
  "gitRepos": [
    "paradigm-threat-files",
    "relay-master",
    "relay-ssr-cache"
  ],
  "health": {
    "query": "venus",
    "repos": [
      "paradigm-threat-files",
      "paradigm-threat-timeline"
    ],
    "sslDomains": [
      "paradigmthreat.net",
      "www.paradigmthreat.net",
      "relay.paradigmthreat.net",
      "clevertree.net",
      "www.clevertree.net",
      "relay.clevertree.net",
      "flashbackrepository.org",
      "www.flashbackrepository.org"
    ]
  }
}
