{
  "schema": "relay.ops.fleet.v1",
  "fleetIngress": "fleet.relaygateway.net",
  "gitPort": 9418,
  "mail": {
    "host": "iad1.relaygateway.net",
    "maildir": "/home/arl/Maildir"
  },
  "nodes": [
    {
      "fqdn": "iad1.relaygateway.net",
      "sshUser": "ubuntu",
      "deployTarget": "spot-iad1",
      "spotCloudspace": "relay-network-iad"
    },
    {
      "fqdn": "ord1.relaygateway.net",
      "sshUser": "ubuntu",
      "deployTarget": "spot-ord1",
      "spotCloudspace": "relay-network-ord"
    },
    {
      "fqdn": "hkg1.relaygateway.net",
      "sshUser": "ubuntu",
      "deployTarget": "spot-hkg1",
      "spotCloudspace": "relay-network-hkg"
    }
  ],
  "gitRepos": [
    "paradigm-threat-files",
    "relay-master"
  ],
  "health": {
    "query": "venus",
    "repos": [
      "paradigm-threat-files",
      "paradigm-threat-timeline"
    ],
    "sslDomains": [
      "paradigmthreat.net",
      "www.paradigmthreat.net",
      "relay.paradigmthreat.net",
      "clevertree.net",
      "www.clevertree.net",
      "relay.clevertree.net",
      "flashbackrepository.org",
      "www.flashbackrepository.org"
    ]
  }
}
