#!/usr/bin/env python3
"""
Ingest binary files into IPFS; commit pointer stubs under .relay/assets/ only.

Logical paths (e.g. media/foo.png) stay as local binaries (gitignored).
Git tracks .relay/assets/media/foo.png.ipfs + assets.manifest.json.

Usage:
  relay-ipfs-ingest [paths...]
  relay-ipfs-ingest --ingest-staged   # pre-commit: pin + .relay/assets stubs for staged binaries
  relay-ipfs-ingest --check-staged    # pre-commit: reject raw binaries / unpinned CIDs
  relay-ipfs-ingest --install-hooks   # installs ingest-staged + check-staged
  relay-ipfs-ingest --dry-run

Requires: ipfs CLI (Kubo), git
"""
from __future__ import annotations

import argparse
import hashlib
import json
import re
import subprocess
import sys
from pathlib import Path

POINTER_MAGIC = "relay-ipfs-v1"
MANIFEST = "assets.manifest.json"
SCHEMA = "relay.assets-manifest.v1"
INBOX = ".relay/asset-inbox"
LOCAL = ".relay/local-assets"
ASSETS_DIR = ".relay/assets"
IPFS_SUFFIX = ".ipfs"

BINARY_EXT = {
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".ico", ".pdf", ".zip",
    ".mp3", ".mp4", ".webm", ".mkv", ".avi", ".mov",
    ".woff", ".woff2", ".ttf", ".eot", ".doc", ".docx", ".epub",
}

BINARY_GITIGNORE_LINES = [
    "*.png", "*.jpg", "*.jpeg", "*.gif", "*.webp", "*.ico",
    "*.pdf", "*.PDF", "*.zip",
    "*.mp3", "*.mp4", "*.webm", "*.mkv", "*.avi", "*.mov",
    "*.woff", "*.woff2", "*.ttf", "*.eot",
    "*.doc", "*.docx", "*.epub",
]

GITIGNORE_BLOCK = (
    "\n# Relay IPFS ingest (relay-ipfs-ingest)\n"
    f"{INBOX}/\n"
    f"{LOCAL}/\n"
    "# Track .relay/assets/*.ipfs in Git; do not ignore .relay/assets/\n"
    "# Logical asset binaries — commit .relay/assets/*.ipfs via relay-ipfs-ingest\n"
    + "\n".join(BINARY_GITIGNORE_LINES)
    + "\n"
)

RELAY_GITIGNORE_MARKER = "# Relay IPFS ingest (relay-ipfs-ingest)"


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, text=True, capture_output=True, **kw)


def run_bytes(cmd: list[str]) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, check=False, capture_output=True)


def ipfs_cat_bytes(cid: str) -> bytes | None:
    proc = run_bytes(["ipfs", "cat", f"/ipfs/{cid}"])
    if proc.returncode != 0 or not proc.stdout:
        return None
    return proc.stdout


def is_git_repo(root: Path) -> bool:
    return (root / ".git").exists()


def central_stub_path(rel: str) -> Path:
    rel = rel.lstrip("/")
    return Path(ASSETS_DIR) / f"{rel}{IPFS_SUFFIX}"


def is_assets_ipfs_stub(path: Path, root: Path) -> bool:
    try:
        rel = path.relative_to(root).as_posix()
    except ValueError:
        return False
    return rel.startswith(f"{ASSETS_DIR}/") and rel.endswith(IPFS_SUFFIX)


def file_is_binary(path: Path, root: Path) -> bool:
    if is_assets_ipfs_stub(path, root):
        return False
    if path.suffix.lower() in {".md", ".svg", ".json", ".txt", ".yaml", ".yml", ".cs", ".html", ".css", ".js"}:
        if path.name == MANIFEST:
            return False
        if path.suffix.lower() == ".ipfs":
            return False
    data = path.read_bytes()[:8192]
    if data.startswith(b"relay-ipfs-v1\n"):
        return False
    if b"\0" in data:
        return True
    try:
        data.decode("utf-8")
        return False
    except UnicodeDecodeError:
        return path.suffix.lower() in BINARY_EXT or len(data) > 256


def is_pointer_bytes(data: bytes) -> bool:
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        return False
    lines = text.splitlines()
    return len(lines) >= 2 and lines[0].strip() == POINTER_MAGIC


def cid_from_stub(data: bytes) -> str | None:
    if not is_pointer_bytes(data):
        return None
    lines = data.decode("utf-8").splitlines()
    return lines[1].strip() if len(lines) > 1 else None


def fields_from_stub(data: bytes, fallback_path: Path) -> tuple[str, str, str] | None:
    """CID, content-type, sha256 hex from stub bytes."""
    if not is_pointer_bytes(data):
        return None
    lines = data.decode("utf-8").splitlines()
    cid = lines[1].strip() if len(lines) > 1 else ""
    if not cid:
        return None
    mime = (
        lines[2].strip()
        if len(lines) > 2 and lines[2].strip()
        else guess_mime(fallback_path)
    )
    sha = ""
    for line in lines[3:]:
        if line.strip().startswith("sha256="):
            sha = line.strip().split("=", 1)[1].strip()
            break
    return cid, mime, sha


def ipfs_add(path: Path) -> str:
    proc = run(["ipfs", "add", "--pin", "--quieter", "--cid-version=1", str(path)])
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or proc.stdout or "ipfs add failed\n")
        sys.exit(1)
    cid = proc.stdout.strip().split()[-1]
    if not re.match(r"^(bafy|bafk|Qm)", cid):
        sys.exit(f"unexpected ipfs add output: {proc.stdout!r}")
    return cid


def ipfs_cid_pinned(cid: str) -> bool:
    proc = run(["ipfs", "block", "stat", f"/ipfs/{cid}", "--offline"])
    if proc.returncode == 0:
        return True
    proc = run(["ipfs", "pin", "ls", "--type=recursive", "-q"])
    if proc.returncode != 0:
        return False
    return cid in proc.stdout.split()


def require_cid_pinned(cid: str, context: str) -> None:
    if not ipfs_cid_pinned(cid):
        sys.stderr.write(
            f"CID not pinned locally ({context}): {cid}\n"
            "Start `ipfs daemon` and re-run ingest, or `ipfs pin add`.\n"
        )
        sys.exit(1)


def sha256_file(path: Path) -> str:
    h = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1024 * 1024), b""):
            h.update(chunk)
    return h.hexdigest()


def guess_mime(path: Path) -> str:
    import mimetypes
    t, _ = mimetypes.guess_type(str(path))
    return t or "application/octet-stream"


def make_stub(cid: str, mime: str, sha: str) -> str:
    return f"{POINTER_MAGIC}\n{cid}\n{mime}\nsha256={sha}\n"


def load_manifest(root: Path) -> dict:
    p = root / MANIFEST
    if p.is_file():
        return json.loads(p.read_text(encoding="utf-8"))
    return {"schema": SCHEMA, "assets": []}


def save_manifest(root: Path, doc: dict) -> None:
    assets = doc.get("assets") or []
    assets.sort(key=lambda a: a.get("path", ""))
    doc["schema"] = SCHEMA
    doc["assets"] = assets
    (root / MANIFEST).write_text(json.dumps(doc, indent=2) + "\n", encoding="utf-8")


def upsert_asset(doc: dict, path: str, cid: str, mime: str, sha: str, size: int) -> None:
    rel = path.lstrip("/")
    assets = doc.setdefault("assets", [])
    entry = {
        "id": rel.replace("/", "_"),
        "path": rel,
        "ipfs": cid,
        "contentType": mime,
        "sha256": sha,
        "bytes": size,
    }
    for i, a in enumerate(assets):
        if a.get("path") == rel:
            assets[i] = entry
            return
    assets.append(entry)


def git_paths_staged(root: Path) -> list[Path]:
    proc = run(["git", "-C", str(root), "diff", "--cached", "--name-only", "--diff-filter=ACM"])
    if proc.returncode != 0:
        return []
    return [root / p for p in proc.stdout.splitlines() if p.strip()]


def git_paths_changed(root: Path) -> list[Path]:
    proc = run(["git", "-C", str(root), "status", "--porcelain"])
    paths = []
    for line in proc.stdout.splitlines():
        if len(line) < 4:
            continue
        p = line[3:].strip()
        if " -> " in p:
            p = p.split(" -> ", 1)[1]
        paths.append(root / p)
    return paths


def git_tracked(root: Path, rel: str) -> bool:
    proc = run(["git", "-C", str(root), "ls-files", "--error-unmatch", rel])
    return proc.returncode == 0


def unstage_logical_if_tracked(root: Path, rel: str) -> None:
    if git_tracked(root, rel):
        run(["git", "-C", str(root), "rm", "--cached", "-f", rel])


def ingest_file(root: Path, path: Path, dry_run: bool) -> bool:
    if not path.is_file():
        return False
    if is_assets_ipfs_stub(path, root):
        return False
    data = path.read_bytes()
    if is_pointer_bytes(data):
        return False
    if not file_is_binary(path, root):
        return False

    mime = guess_mime(path)
    sha = sha256_file(path)
    rel = str(path.relative_to(root))
    stub_rel = str(central_stub_path(rel))

    if dry_run:
        print(f"would ingest: {rel} -> {stub_rel}")
        return True

    cid = ipfs_add(path)
    require_cid_pinned(cid, f"after ingest of {rel}")

    stub = make_stub(cid, mime, sha)
    stub_path = root / stub_rel
    stub_path.parent.mkdir(parents=True, exist_ok=True)
    stub_path.write_text(stub, encoding="utf-8")

    local_copy = root / LOCAL / rel
    local_copy.parent.mkdir(parents=True, exist_ok=True)
    local_copy.write_bytes(data)

    unstage_logical_if_tracked(root, rel)

    doc = load_manifest(root)
    upsert_asset(doc, rel, cid, mime, sha, len(data))
    save_manifest(root, doc)

    run(["git", "-C", str(root), "add", stub_rel, MANIFEST])
    print(f"ingested {rel} -> {cid} ({stub_rel})")
    return True


def migrate_inline_pointer(root: Path, path: Path, dry_run: bool) -> bool:
    """Legacy layout: text stub at logical path → central .relay/assets/*.ipfs (reuse CID)."""
    if not path.is_file() or is_assets_ipfs_stub(path, root):
        return False
    data = path.read_bytes()
    if not is_pointer_bytes(data):
        return False
    parsed = fields_from_stub(data, path)
    if parsed is None:
        return False
    cid, mime, sha = parsed
    rel = str(path.relative_to(root))
    stub_rel = str(central_stub_path(rel))
    stub_path = root / stub_rel

    if dry_run:
        print(f"would migrate inline pointer: {rel} -> {stub_rel} ({cid})")
        return True

    require_cid_pinned(cid, f"inline pointer {rel}")

    stub_path.parent.mkdir(parents=True, exist_ok=True)
    if not stub_path.is_file() or stub_path.read_bytes() != data:
        stub_path.write_bytes(data)

    local_copy = root / LOCAL / rel
    if not local_copy.is_file():
        payload = ipfs_cat_bytes(cid)
        if payload is not None:
            local_copy.parent.mkdir(parents=True, exist_ok=True)
            local_copy.write_bytes(payload)

    unstage_logical_if_tracked(root, rel)

    doc = load_manifest(root)
    size = local_copy.stat().st_size if local_copy.is_file() else 0
    if not sha and local_copy.is_file():
        sha = sha256_file(local_copy)
    upsert_asset(doc, rel, cid, mime, sha, size)
    save_manifest(root, doc)

    run(["git", "-C", str(root), "add", stub_rel, MANIFEST])
    print(f"migrated inline pointer {rel} -> {stub_rel} ({cid})")
    return True


def ingest_staged(root: Path, dry_run: bool) -> int:
    changed = False
    for path in git_paths_staged(root):
        if ingest_file(root, path, dry_run):
            changed = True
        elif migrate_inline_pointer(root, path, dry_run):
            changed = True
    if not changed:
        return 0
    return 0


def check_staged(root: Path) -> int:
    errors: list[str] = []
    for path in git_paths_staged(root):
        if not path.is_file():
            continue
        rel = str(path.relative_to(root))
        data = path.read_bytes()

        if is_assets_ipfs_stub(path, root):
            cid = cid_from_stub(data)
            if cid is None:
                errors.append(f"invalid IPFS stub: {rel}")
            elif not ipfs_cid_pinned(cid):
                errors.append(f"CID not pinned locally: {rel} ({cid})")
            continue

        if rel == MANIFEST:
            try:
                doc = json.loads(data.decode("utf-8"))
            except json.JSONDecodeError:
                errors.append(f"invalid JSON: {MANIFEST}")
                continue
            for asset in doc.get("assets") or []:
                cid = (asset.get("ipfs") or "").strip()
                if cid and not ipfs_cid_pinned(cid):
                    errors.append(
                        f"manifest asset not pinned: {asset.get('path', '?')} ({cid})"
                    )
            continue

        if is_pointer_bytes(data):
            errors.append(
                f"inline IPFS stub at public path (run relay-ipfs-ingest --ingest-staged): {rel}"
            )
            continue
        if file_is_binary(path, root):
            errors.append(rel)

    if errors:
        if any(not e.startswith("invalid") and "not pinned" not in e and "manifest" not in e for e in errors):
            staged_bins = [e for e in errors if "not pinned" not in e and not e.startswith("invalid")]
            if staged_bins:
                sys.stderr.write("Binary files staged without IPFS ingest:\n")
                for b in staged_bins:
                    sys.stderr.write(f"  {b}\n")
                sys.stderr.write("Run: relay-ipfs-ingest " + " ".join(staged_bins) + "\n")
        for e in errors:
            if "not pinned" in e or e.startswith("invalid"):
                sys.stderr.write(f"{e}\n")
        return 1
    return 0


def install_hooks(root: Path) -> None:
    hook = root / ".git" / "hooks" / "pre-commit"
    script_dir = Path(__file__).resolve().parent
    relay_lines = [
        "# Relay IPFS (relay-ipfs-ingest --install-hooks)",
        f'export PATH="{script_dir}:$PATH"',
        "relay-ipfs-ingest --ingest-staged",
        "relay-ipfs-ingest --check-staged",
    ]
    other_lines: list[str] = []
    if hook.is_file():
        text = hook.read_text(encoding="utf-8")
        in_relay = False
        for line in text.splitlines():
            if line.startswith("# Relay IPFS"):
                in_relay = True
                continue
            if in_relay:
                if line.startswith("relay-ipfs-ingest") or line.startswith("export PATH="):
                    continue
                in_relay = False
            if not in_relay and line.strip() and line.strip() != "#!/bin/sh":
                other_lines.append(line)
    shebang = "#!/bin/sh"
    body = [shebang, *relay_lines]
    if other_lines:
        body.extend(other_lines)
    hook.write_text("\n".join(body) + "\n", encoding="utf-8")
    hook.chmod(0o755)
    print(f"installed pre-commit hook -> {hook}")


def ensure_gitignore(root: Path) -> None:
    gi = root / ".gitignore"
    text = gi.read_text(encoding="utf-8") if gi.is_file() else ""
    lines = [
        ln
        for ln in text.splitlines()
        if ln.strip() not in (".relay/", ".relay")
    ]
    text = "\n".join(lines).rstrip()
    if RELAY_GITIGNORE_MARKER not in text:
        text = text + GITIGNORE_BLOCK
        gi.write_text(text if text.endswith("\n") else text + "\n", encoding="utf-8")
        print(f"updated {gi}")
    elif any(ln.strip() in (".relay/", ".relay") for ln in gi.read_text(encoding="utf-8").splitlines()):
        gi.write_text(("\n".join(lines) + "\n") if lines else "", encoding="utf-8")
        print(f"removed blanket .relay/ ignore from {gi}")


def main() -> int:
    ap = argparse.ArgumentParser(description="Relay IPFS ingest for thin repos")
    ap.add_argument("paths", nargs="*", help="Files to ingest (default: changed/untracked)")
    ap.add_argument(
        "--ingest-staged",
        action="store_true",
        help="Ingest staged binaries (ipfs add --pin) and migrate inline stubs to .relay/assets/",
    )
    ap.add_argument("--check-staged", action="store_true", help="Exit 1 if staged binaries")
    ap.add_argument(
        "--install-hooks",
        action="store_true",
        help="Install pre-commit: --ingest-staged then --check-staged",
    )
    ap.add_argument("--dry-run", action="store_true")
    args = ap.parse_args()
    root = Path.cwd()
    if not is_git_repo(root):
        sys.stderr.write("Not a git repository\n")
        return 1

    if args.install_hooks:
        install_hooks(root)
        ensure_gitignore(root)
        return 0

    if args.ingest_staged:
        return ingest_staged(root, args.dry_run)

    if args.check_staged:
        return check_staged(root)

    targets: list[Path] = []
    if args.paths:
        targets = [root / p for p in args.paths]
    else:
        targets = git_paths_changed(root)

    changed = False
    for t in targets:
        if ingest_file(root, t, args.dry_run):
            changed = True
        elif migrate_inline_pointer(root, t, args.dry_run):
            changed = True
    if not changed and not args.paths:
        print("no binary files to ingest")
    return 0


if __name__ == "__main__":
    sys.exit(main())
