# Example relay environment (no secrets — copy to relay.env per server; never commit relay.env).
# Policy: docs/SECRETS_POLICY.md
#
# On a real host, install.sh sets /opt/relay/relay.env to root:root chmod 600 (not writable by relay).
# Edits: sudo only, or install.sh update | repair. Vars reach relay-gateway via systemd EnvironmentFile.
# See docs/DEPLOY_LINODE.md and docs/RELAY_RECONCILE_PLAN.md.

# --- Identity & HTTP routing (per node — set on each host) ---
RELAY_PUBLIC_HOSTNAME=your-node.relaygateway.net
RELAY_SERVER_ID=relay-your-node

# --- Paths (production defaults) ---
RELAY_REPO_PATH=/opt/relay/data
RELAY_STATIC_DIR=/opt/relay/www
# RELAY_FEATURES_STATE_PATH=/opt/relay/state/features.json

# --- HTTP ---
RELAY_HTTP_PORT=8080
RELAY_BIND=0.0.0.0:8080

# --- Trust (catalog only — same trust root on all peers once catalog repo matches) ---
# Greenfield: set RELAY_MASTER_CATALOG_GIT_URL — first boot clones into RELAY_MASTER_CATALOG_PATH (or /opt/relay/src/relay-master if path omitted).
RELAY_MASTER_CATALOG_PATH=/opt/relay/src/relay-master
RELAY_MASTER_CATALOG_GIT_URL=https://gitlab.com/clevertree/relay-master.git
# RELAY_MASTER_CATALOG_BRANCH=main
# Optional: deeper initial catalog clone if trust-root is far below tip (default in relay-startup-catalog-sync.sh is 128).
# RELAY_MASTER_CATALOG_CLONE_DEPTH=128
RELAY_MASTER_TRUST_ROOT=CHANGEME_git_rev_list_max_parents_0_of_catalog_main
RELAY_DEFAULT_REPO=relay-master

# --- Mesh — full master peer list must match on every master; secrets identical across masters you rotate together ---
# Quote for bash source — semicolon-separated FQDNs.
RELAY_MASTER_PEER_LIST="atlanta2.relaygateway.net;atlanta3.relaygateway.net"
RELAY_MASTER_MESH_SECRET=CHANGEME_hex_or_strong_random_same_on_all_masters
RELAY_PEER_SECRET=CHANGEME_hex_or_strong_random_same_on_all_masters
# RELAY_MESH_EVENT_SECRET=
# RELAY_MESH_EVENT_SCHEME=https
# RELAY_MESH_EVENT_URLS=
# RELAY_MESH_EVENT_CHANNEL=#relay-alerts
# Optional: template for peer probes from POST /api/status (default POST https://{host}/api/config). Use {host} placeholder.
# RELAY_STATUS_PEER_URL_TEMPLATE=https://{host}/api/config

# --- Helm-style reconcile (optional; relay-master deploy/relay-gateway.json) ---
# RELAY_RECONCILE_ENABLED=1
# RELAY_RECONCILE_ENABLE_TIMER=1   # enable systemd relay-reconcile.timer (install/update/repair)
# RELAY_MASTER_CATALOG_BRANCH=main

# --- Git ---
RELAY_GIT_PORT=9418
RELAY_GIT_ENSURE_BARE_ENABLED=1

# --- Startup (systemd ExecStartPre before relay-gateway): catalog sync + peer fetch ---
# RELAY_STARTUP_CATALOG_SYNC=1   # 0 to skip (e.g. if catalog path wrong during debug)
# RELAY_INSTALL_ROOT=/opt/relay   # set automatically by systemd unit; for manual runs

# --- Optional notify (rotate with relay.env when you rotate mesh secrets) ---
# RELAY_NOTIFY_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# RELAY_SLACK_BOT_TOKEN=
# RELAY_SLACK_DEDUP_CHANNEL_ID=

# --- Optional: install/repair checks deploy SSH key is in RELAY_DEPLOY_SSH_USER authorized_keys ---
# RELAY_VALIDATE_DEPLOY_SSH_KEY=1
# RELAY_DEPLOY_SSH_USER=ari
# RELAY_DEPLOY_SSH_KEY_FINGERPRINT=SHA256:...   # substring from: ssh-keygen -lf -E sha256 ~/.ssh/your_deploy_key.pub
