# Rust/Cargo
target/
**/target/
debug/
release/
*.kubeconfig.yaml

# Keep Cargo.lock committed for binaries/apps (do not ignore)
# !Cargo.lock

# OS/Editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Env files
.env
.env.*
!.env.example
# Local copy: cp relay.env.example relay.env (or docs/examples/relay.env). relay.env.example is tracked.
relay.env

# Logs and coverage
*.log
coverage/
.nyc_output/

# Node (if present in subtools)
node_modules/
**/node_modules/
pnpm-lock.yaml
yarn.lock
package-lock.json
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Optional prebuilt binaries (see dist/README.md, docs/DEPLOY_SELF_HOSTED.md)
dist/linux-amd64/
dist/linux-arm64/

# Local / dev logs (nested names may not match *.log)
logs/

# Python (scripts helpers)
**/__pycache__/

# Vendored crates: keep only Rust sources in git (avoid JNI .so, wasm, Gradle)
relay-runtime/android/
relay-runtime/gradle/
relay-runtime/.gradle/
relay-runtime/examples/
relay-runtime/js/
relay-runtime/*.gradle
relay-runtime/gradlew
relay-runtime/settings.gradle
relay-runtime/gradle.properties

# Misc caches
**/.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Local Docker IPFS dev (bare repo copies)
docker-data/

# Rackspace secrets (use terraform.tfvars.example)
terraform/rackspace-spot/terraform.tfvars
terraform/rackspace-spot/secrets.auto.tfvars
